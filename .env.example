# SPDX and secrets are not committed. Supply real credentials only through deployment secrets.
APP_NAME=Gen-AI Locator Finder
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

LOCATOR_APP_URL=
LOCATOR_APP_USERNAME=
LOCATOR_APP_PASSWORD=
LOCATOR_TENANT=
LOCATOR_LOGIN_PROFILE=standard_form

LOCATOR_HEADLESS=true
LOCATOR_BROWSER_TIMEOUT_MS=15000
LOCATOR_CAPTURE_SCREENSHOTS=false
LOCATOR_MAX_RETRIES=2
LOCATOR_DEFAULT_PROVIDER=mock
LOCATOR_LITELLM_MODEL=gpt-4o-mini
LOCATOR_GEMINI_MODEL=gemini-2.5-flash
LOCATOR_LLM_TIMEOUT_SECONDS=30

LOCATOR_VECTOR_STORE=chroma
LOCATOR_CHROMA_DIR=.data/chroma
LOCATOR_CHROMA_COLLECTION=locator_candidates
LOCATOR_MILVUS_URI=http://localhost:19530
LOCATOR_MILVUS_COLLECTION=locator_candidates

LOCATOR_REPORTS_DIR=.data/reports
LOCATOR_ENABLE_OTEL=false
LOCATOR_OTEL_SERVICE_NAME=gen-ai-locator-finder
OPENAI_API_KEY=
GEMINI_API_KEY=
